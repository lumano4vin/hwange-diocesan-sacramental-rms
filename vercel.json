{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{Hwange_Diocesan_Sacramental_RMS_Manual.pdf,docs/**,assets/**,data/**,includes/**}"
    }
  },
  "routes": [
    {
      "src": "/Hwange_Diocesan_Sacramental_RMS_Manual.pdf",
      "dest": "/download_manual.php"
    },
    {
      "src": "/manual",
      "dest": "/download_manual.php"
    },
    {
      "src": "/$",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)\\.php",
      "dest": "/api/index.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
