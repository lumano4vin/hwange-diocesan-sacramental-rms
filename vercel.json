{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{*.php,admin/**,actions/**,auth/**,dashboard/**,sacraments/**,parishioners/**,includes/**,assets/**,data/**,docs/**,Hwange_Diocesan_Sacramental_RMS_Manual.pdf}"
    }
  },
  "routes": [
    {
      "src": "/Hwange_Diocesan_Sacramental_RMS_Manual.pdf",
      "dest": "/api/index.php"
    },
    {
      "src": "/download_manual.php",
      "dest": "/api/index.php"
    },
    {
      "src": "/manual",
      "dest": "/api/index.php"
    },
    {
      "src": "/$",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)\\.php",
      "dest": "/api/index.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
